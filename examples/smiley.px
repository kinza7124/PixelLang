// Smiley Face
// Demonstrates circles and ellipses

CANVAS 50 50;

// Yellow face background
CIRCLE 25 25 20 #FFEB3B;

// Eyes (white circles with black pupils)
CIRCLE 18 18 5 #FFFFFF;
CIRCLE 32 18 5 #FFFFFF;
CIRCLE 18 18 2 #000000;
CIRCLE 32 18 2 #000000;

// Smile (using small rectangles and pixels)
PIXEL 15 30 #000000;
PIXEL 16 32 #000000;
PIXEL 17 33 #000000;
PIXEL 18 34 #000000;
PIXEL 19 34 #000000;
PIXEL 20 35 #000000;
PIXEL 21 35 #000000;
PIXEL 22 35 #000000;
PIXEL 23 35 #000000;
PIXEL 24 35 #000000;
PIXEL 25 35 #000000;
PIXEL 26 34 #000000;
PIXEL 27 34 #000000;
PIXEL 28 33 #000000;
PIXEL 29 32 #000000;
PIXEL 30 30 #000000;
