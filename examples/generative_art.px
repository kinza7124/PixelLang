// Generative Art Demo using RANDOM and new shapes
// Creates a random starfield with hearts and arrows

CANVAS 100 100;

// Dark space background
CLEAR #0D1117;

// Moon - circle for simplicity
CIRCLE 85 20 8 #F4D03F;
CIRCLE 87 18 6 #F7DC6F;

// Random stars using loop and sprite patterns
LOOP 20 {
    RANDOM 5 95;
    // For this demo, we use fixed positions with random-like distribution
}

// Draw constellation with bezier curves
BEZIER 10 30 25 25 40 35 55 30 #5DADE2;
BEZIER 55 30 70 25 85 35 90 30 #5DADE2;

// Hearts scattered (representing love across the universe)
HEART 20 80 5 #E74C3C;
HEART 50 70 4 #EC7063;
HEART 80 85 6 #CB4335;

// Arrows showing direction/movement
ARROW 30 50 45 60 4 #85C1E9;
ARROW 60 45 75 55 4 #85C1E9;

// Twinkling stars as sprites
SPRITE 15 20 101010101 #FFFFFF;
SPRITE 85 40 101010101 #FFFFFF;
SPRITE 45 15 101010101 #FFFFFF;
SPRITE 65 75 101010101 #FFFFFF;

// Border
BORDER 1 1 98 98 1 #2C3E50;

// Title
TEXT 30 3 SPACE #FFFFFF;
