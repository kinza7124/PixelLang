// Diagonal Rainbow Pattern
// Uses PIXEL directly at positions (no negative translates)

CANVAS 64 64;

// Dark background
RECT 0 0 64 64 #1A1A2A;

// Draw diagonal rainbow lines
// Red line at x=0
PIXEL 0 0 #FF0000;
PIXEL 4 4 #FF0000;
PIXEL 8 8 #FF0000;
PIXEL 12 12 #FF0000;
PIXEL 16 16 #FF0000;
PIXEL 20 20 #FF0000;
PIXEL 24 24 #FF0000;
PIXEL 28 28 #FF0000;
PIXEL 32 32 #FF0000;
PIXEL 36 36 #FF0000;
PIXEL 40 40 #FF0000;
PIXEL 44 44 #FF0000;
PIXEL 48 48 #FF0000;
PIXEL 52 52 #FF0000;
PIXEL 56 56 #FF0000;
PIXEL 60 60 #FF0000;

// Orange line at x=4
PIXEL 4 0 #FF7F00;
PIXEL 8 4 #FF7F00;
PIXEL 12 8 #FF7F00;
PIXEL 16 12 #FF7F00;
PIXEL 20 16 #FF7F00;
PIXEL 24 20 #FF7F00;
PIXEL 28 24 #FF7F00;
PIXEL 32 28 #FF7F00;
PIXEL 36 32 #FF7F00;
PIXEL 40 36 #FF7F00;
PIXEL 44 40 #FF7F00;
PIXEL 48 44 #FF7F00;
PIXEL 52 48 #FF7F00;
PIXEL 56 52 #FF7F00;
PIXEL 60 56 #FF7F00;

// Yellow line at x=8
PIXEL 8 0 #FFFF00;
PIXEL 12 4 #FFFF00;
PIXEL 16 8 #FFFF00;
PIXEL 20 12 #FFFF00;
PIXEL 24 16 #FFFF00;
PIXEL 28 20 #FFFF00;
PIXEL 32 24 #FFFF00;
PIXEL 36 28 #FFFF00;
PIXEL 40 32 #FFFF00;
PIXEL 44 36 #FFFF00;
PIXEL 48 40 #FFFF00;
PIXEL 52 44 #FFFF00;
PIXEL 56 48 #FFFF00;
PIXEL 60 52 #FFFF00;

// Green line at x=12
PIXEL 12 0 #00FF00;
PIXEL 16 4 #00FF00;
PIXEL 20 8 #00FF00;
PIXEL 24 12 #00FF00;
PIXEL 28 16 #00FF00;
PIXEL 32 20 #00FF00;
PIXEL 36 24 #00FF00;
PIXEL 40 28 #00FF00;
PIXEL 44 32 #00FF00;
PIXEL 48 36 #00FF00;
PIXEL 52 40 #00FF00;
PIXEL 56 44 #00FF00;
PIXEL 60 48 #00FF00;

// Blue line at x=16
PIXEL 16 0 #0000FF;
PIXEL 20 4 #0000FF;
PIXEL 24 8 #0000FF;
PIXEL 28 12 #0000FF;
PIXEL 32 16 #0000FF;
PIXEL 36 20 #0000FF;
PIXEL 40 24 #0000FF;
PIXEL 44 28 #0000FF;
PIXEL 48 32 #0000FF;
PIXEL 52 36 #0000FF;
PIXEL 56 40 #0000FF;
PIXEL 60 44 #0000FF;

// Indigo line at x=20
PIXEL 20 0 #4B0082;
PIXEL 24 4 #4B0082;
PIXEL 28 8 #4B0082;
PIXEL 32 12 #4B0082;
PIXEL 36 16 #4B0082;
PIXEL 40 20 #4B0082;
PIXEL 44 24 #4B0082;
PIXEL 48 28 #4B0082;
PIXEL 52 32 #4B0082;
PIXEL 56 36 #4B0082;
PIXEL 60 40 #4B0082;

// Violet line at x=24
PIXEL 24 0 #9400D3;
PIXEL 28 4 #9400D3;
PIXEL 32 8 #9400D3;
PIXEL 36 12 #9400D3;
PIXEL 40 16 #9400D3;
PIXEL 44 20 #9400D3;
PIXEL 48 24 #9400D3;
PIXEL 52 28 #9400D3;
PIXEL 56 32 #9400D3;
PIXEL 60 36 #9400D3;
